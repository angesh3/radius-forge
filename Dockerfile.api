# RadiusForge API Backend Dockerfile
FROM python:3.9-slim

# Install system dependencies including build tools for psutil
RUN apt-get update && apt-get install -y \
    curl \
    netcat-traditional \
    build-essential \
    python3-dev \
    gcc \
    g++ \
    libc6-dev \
    make \
    pkg-config \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install additional database drivers (asyncpg only for async PostgreSQL)
RUN pip install --no-cache-dir asyncpg

# Copy source code
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY VERSION .
COPY CLAUDE.md .

# Create necessary directories
RUN mkdir -p /app/logs /app/reports /app/data

# Expose API port
EXPOSE 8910 8915

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8910/health || exit 1

# Start API server
CMD ["python", "-m", "uvicorn", "src.api.main_simple:app", "--host", "0.0.0.0", "--port", "8910"]
