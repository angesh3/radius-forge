# RadiusForge Environment Configuration
# Copy this file to .env and update with your values

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=RadiusForge
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# =============================================================================
# API Server Configuration (per PRD.md - production ports 8910-8926)
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8910
API_WORKERS=4
API_RELOAD=true

# v1.3.0 Port Range Configuration (8910-8926)
UI_PORT=8911
WEBSOCKET_PORT=8912
RADIUS_TEST_PORT=8913
TACACS_TEST_PORT=8914
SYSLOG_PORT=8915
METRICS_EXPORT_PORT=8916
HEALTH_CHECK_PORT=8917
ADMIN_API_PORT=8918
BACKUP_SERVICE_PORT=8919
RESERVED_PORT=8920
PXGRID_SERVICE_PORT=8921
CONNECTIVITY_PROBE_PORT=8922
SIMULATOR_PORT=8923
ORCHESTRATOR_PORT=8924
ANALYTICS_PORT=8925
EXTENDED_RESERVED_PORT=8926

# Security Configuration v1.3.0
RADIUSFORGE_API_KEY=your-secure-api-key-here-change-in-production
ENABLE_RATE_LIMITING=true
BUNDLE_VERIFICATION_ENABLED=true

# Frontend URL
FRONTEND_URL=http://localhost:5173

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql://radiusforge:password@localhost:5432/radiusforge
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Test Database
TEST_DATABASE_URL=postgresql://radiusforge:password@localhost:5432/radiusforge_test

# =============================================================================
# Redis Configuration (for caching and WebSocket)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_POOL_SIZE=10

# =============================================================================
# WebSocket Configuration
# =============================================================================
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000
WS_MESSAGE_QUEUE_SIZE=100

# =============================================================================
# RADIUS Configuration
# =============================================================================
RADIUS_SECRET=testing123
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_TIMEOUT=5
RADIUS_RETRIES=3
RADIUS_MAX_SESSIONS=10000

# =============================================================================
# TACACS+ Configuration
# =============================================================================
TACACS_SECRET=tacacs123
TACACS_PORT=49
TACACS_TIMEOUT=5

# =============================================================================
# Syslog Configuration
# =============================================================================
SYSLOG_PORT=8915
SYSLOG_PROTOCOL=TCP
SYSLOG_MAX_MESSAGE_SIZE=8192

# =============================================================================
# Test Targets
# =============================================================================
# Asset Manager
ASSET_MANAGER_HOST=10.0.0.100
ASSET_MANAGER_RADIUS_PORT=1812
ASSET_MANAGER_TACACS_PORT=49

# Cisco ISE (optional)
ISE_HOST=10.0.0.200
ISE_RADIUS_PORT=1812
ISE_TACACS_PORT=49
ISE_PXGRID_HOST=10.0.0.201
ISE_PXGRID_PORT=8920

# =============================================================================
# Performance Limits
# =============================================================================
MAX_RPS=100000
MAX_CONCURRENT_TESTS=10
MAX_TEST_DURATION=3600
DEFAULT_TEST_DURATION=300
METRICS_INTERVAL=1

# =============================================================================
# Reporting Configuration
# =============================================================================
REPORT_DIR=./reports
REPORT_RETENTION_DAYS=30
REPORT_FORMAT=html,pdf,json

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=RadiusForge <noreply@radiusforge.local>
SMTP_TLS=true

# =============================================================================
# Monitoring & Observability
# =============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
METRICS_EXPORT_INTERVAL=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=./logs
LOG_ROTATION=daily
LOG_RETENTION_DAYS=7

# =============================================================================
# Security Configuration
# =============================================================================
# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# IP Allowlist (comma-separated, empty = allow all)
IP_ALLOWLIST=

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_THREAT_GENERATOR=true
FEATURE_ISE_INTEGRATION=true
FEATURE_EXPORT_CSV=true
FEATURE_EMAIL_REPORTS=true
FEATURE_MULTI_DATACENTER=false

# =============================================================================
# Multi-Agent Orchestration
# =============================================================================
ORCHESTRATOR_ENABLED=true
ORCHESTRATOR_LOG_LEVEL=DEBUG
AGENT_TIMEOUT=300
QUALITY_GATES_ENABLED=true

# =============================================================================
# Development Settings
# =============================================================================
# Mock Mode (bypass actual RADIUS/TACACS+ for development)
MOCK_MODE=false
MOCK_LATENCY_MIN=10
MOCK_LATENCY_MAX=100
MOCK_SUCCESS_RATE=99.5

# Development Database
DEV_DB_SEED=true
DEV_DB_SAMPLE_DATA=true

# =============================================================================
# Docker Configuration
# =============================================================================
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE_PREFIX=radiusforge
DOCKER_TAG=latest
